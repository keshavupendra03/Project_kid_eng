      "text": {
        "hi": "आज के 10 नए शब्द: समाज और सरकार। हर शब्द सुनो, समझो और बोलो।",
        "hinglish": "Aaj ke 10 naye shabd: Samaaj aur sarkaar. Har shabd suno, samjho aur bolo.",
        "en": "Ten new words today: Society and government. Listen, understand and say each one."
      }
    },
    {
      "type": "learn_word",
      "id": "W78.P02.S02",
      "skills": [
        "vocab.power"
      ],
      "word": {
        "english": "citizen",
        "emoji": "🧑",
        "hindi": "नागरिक",
        "hinglish": "naagrik"
      },
      "meaning": "a person who belongs to a country",
      "example": "Every citizen should follow the rules.",
      "exampleMeaning": {
        "hi": "हर नागरिक को नियमों का पालन करना चाहिए।",
        "hinglish": "Har naagrik ko niyamon ka paalan karna chahiye."
      }
    },
    {
      "type": "learn_word",
      "id": "W78.P02.S03",
      "skills": [
        "vocab.power"
      ],
      "word": {
        "english": "government",
        "emoji": "🏛️",
        "hindi": "सरकार",
        "hinglish": "sarkaar"
      },
      "meaning": "the group of people who run a country",
      "example": "The government builds roads and schools.",
      "exampleMeaning": {
        "hi": "सरकार सड़कें और स्कूल बनाती है।",
        "hinglish": "Sarkaar sadkein aur school banaati hai."
      }
    },
    {
      "type": "learn_word",
      "id": "W78.P02.S04",
      "skills": [
        "vocab.power"
      ],
      "word": {
        "english": "election",
        "emoji": "🗳️",
        "hindi": "चुनाव",
        "hinglish": "chunaav"
      },
      "meaning": "choosing leaders by voting",
      "example": "The election will be held next month.",
      "exampleMeaning": {
        "hi": "चुनाव अगले महीने होगा।",
        "hinglish": "Chunaav agle mahine hoga."
      }
    },
    {
      "type": "learn_word",
      "id": "W78.P02.S05",
      "skills": [
        "vocab.power"
      ],
      "word": {
        "english": "vote",
        "emoji": "✅",
        "hindi": "मत देना",
        "hinglish": "mat dena"
      },
      "meaning": "to choose someone in an election",
      "example": "You can vote when you are eighteen.",
      "exampleMeaning": {
        "hi": "अठारह साल के होने पर तुम वोट दे सकते हो।",
        "hinglish": "Athaarah saal ke hone par tum vote de sakte ho."
      }
    },
    {
      "type": "learn_word",
      "id": "W78.P02.S06",
      "skills": [
        "vocab.power"
