          "id": "friends",
          "tinku": "Who will go with you to Kanha?",
          "meaning": {
            "hi": "तुम्हारे साथ कान्हा कौन जाएगा?",
            "hinglish": "Tumhare saath Kanha kaun jaayega?"
          },
          "replies": [
            {
              "say": "My friends Ravi and Seema will go with me.",
              "meaning": {
                "hi": "मेरे दोस्त रवि और सीमा मेरे साथ जाएँगे।",
                "hinglish": "Mere dost Ravi aur Seema mere saath jaayenge."
              },
