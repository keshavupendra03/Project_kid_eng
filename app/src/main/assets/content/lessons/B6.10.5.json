      "turns": [
        {
          "id": "where",
          "tinku": "Where did you go?",
          "meaning": {
            "hi": "तुम कहाँ गए थे?",
            "hinglish": "Tum kahan gaye the?"
          },
          "replies": [
            {
              "say": "I went to Agra.",
              "meaning": {
                "hi": "मैं आगरा गया/गई। (अपनी जगह बोलो)",
                "hinglish": "Main Agra gaya/gayi. (Apni jagah bolo)"
