      ],
      "text": {
        "hi": "इस पाठ में एक बूढ़ा आदमी सिर्फ़ पैरों के निशान देखकर खोए हुए ऊँट के बारे में सब बता देता है! पहले किताब का सवाल: क्या तुम पैरों के निशान पहचान सकते हो?",
        "hinglish": "Is paath mein ek boodha aadmi sirf pairon ke nishaan dekhkar khoye hue oont ke baare mein sab bata deta hai! Pehle kitaab ka sawaal: kya tum pairon ke nishaan pehchaan sakte ho?",
        "en": "In this lesson an old man tells everything about a lost camel just by looking at footprints! First the book's question: can you recognise the footprints of an animal?"
      }
    },
    {
      "type": "choice",
      "id": "B7.07.1.S02",
      "skills": [
        "book.words",
        "vocab.meaning"
      ],
      "question": "Whose footprints are big and round, like a plate?",
      "questionMeaning": {
        "hi": "किसके पैरों के निशान थाली जैसे बड़े और गोल होते हैं?",
        "hinglish": "Kiske pairon ke nishaan thaali jaise bade aur gol hote hain?"
      },
      "options": [
        "elephant",
        "duck",
        "man"
      ],
      "answer": "elephant",
      "emojis": [
        "🐘",
        "🦆",
        "🧍"
      ]
    },
    {
      "type": "choice",
      "id": "B7.07.1.S03",
      "skills": [
        "book.words",
        "vocab.meaning"
      ],
      "question": "Whose footprints look like a fan with three toes joined by skin?",
      "questionMeaning": {
        "hi": "किसके पैरों के निशान पंखे जैसे, तीन उँगलियों वाले होते हैं?",
        "hinglish": "Kiske pairon ke nishaan pankhe jaise, teen ungliyon waale hote hain?"
      },
      "options": [
        "duck",
        "lion",
        "camel"
      ],
      "answer": "duck",
      "emojis": [
        "🦆",
        "🦁",
        "🐪"
      ]
    },
