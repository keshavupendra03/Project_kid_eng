      "text": {
        "hi": "तुम सुबह पार्क में घूमने गए थे। दोस्तों ने सवाल पूछे। जवाब दिए गए हैं, तुम सही सवाल चुनो।",
        "hinglish": "Tum subah park mein ghoomne gaye the. Doston ne sawaal poochhe. Jawab diye gaye hain, tum sahi sawaal chuno.",
        "en": "You went to a park for a morning walk. Your friends asked questions. The answers are given; choose the right question."
      }
    },
    {
      "type": "choice",
      "id": "B8.04.8.S02",
      "skills": [
        "book.talk",
        "grammar.wh_questions"
      ],
      "question": "Ans: I went for a morning walk.",
      "questionMeaning": {
        "hi": "इस जवाब का सवाल चुनो",
        "hinglish": "Is jawab ka sawaal chuno"
      },
      "options": [
        "Where did you go this morning?",
        "Who went with you?",
        "When did you come back?"
      ],
      "answer": "Where did you go this morning?"
    },
    {
      "type": "choice",
      "id": "B8.04.8.S03",
      "skills": [
