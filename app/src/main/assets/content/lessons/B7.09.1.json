      "text": {
        "hi": "यह पाठ एक नाटक है। डॉक्टर दास एक ऐसा घर ख़रीदना चाहते हैं जिसके बारे में लोग कहते हैं कि वहाँ भूत आता है! पहले किताब के सवाल।",
        "hinglish": "Yeh paath ek naatak hai. Doctor Dass ek aisa ghar khareedna chahte hain jiske baare mein log kehte hain ki wahan bhoot aata hai! Pehle kitaab ke sawaal.",
        "en": "This lesson is a play. Doctor Dass wants to buy a house that people say has a ghost! First, the book's questions."
      }
    },
    {
      "type": "roleplay",
      "id": "B7.09.1.S02",
      "skills": [
        "book.talk",
        "speak.sentence"
      ],
      "scene": "👻",
      "turns": [
        {
          "id": "know",
          "tinku": "Do you believe in ghosts?",
          "meaning": {
            "hi": "क्या तुम भूतों पर विश्वास करते हो?",
            "hinglish": "Kya tum bhooton par vishwaas karte ho?"
          },
          "replies": [
            {
              "say": "No, I do not believe in ghosts.",
              "meaning": {
                "hi": "नहीं, मैं भूतों पर विश्वास नहीं करता/करती।",
                "hinglish": "Nahi, main bhooton par vishwaas nahi karta/karti."
              },
              "patterns": [
                "no *",
                "no"
              ]
            },
            {
              "say": "Yes, I believe in ghosts.",
              "meaning": {
                "hi": "हाँ, मैं भूतों पर विश्वास करता/करती हूँ।",
                "hinglish": "Haan, main bhooton par vishwaas karta/karti hoon."
              },
              "patterns": [
                "yes *",
                "yes"
              ]
            }
          ]
        },
        {
          "id": "story",
          "tinku": "Do you know any ghost story, movie or T.V. serial?",
          "meaning": {
            "hi": "क्या तुम कोई भूत की कहानी, फ़िल्म या टीवी सीरियल जानते हो?",
            "hinglish": "Kya tum koi bhoot ki kahani, film ya TV serial jaante ho?"
          },
          "replies": [
            {
              "say": "Yes, I know a funny ghost story.",
              "meaning": {
                "hi": "हाँ, मुझे भूत की एक मज़ेदार कहानी पता है।",
                "hinglish": "Haan, mujhe bhoot ki ek mazedaar kahani pata hai."
              },
              "patterns": [
                "yes *",
                "yes"
              ],
              "next": "end"
            },
            {
              "say": "No, I do not know any.",
              "meaning": {
                "hi": "नहीं, मुझे कोई नहीं पता।",
                "hinglish": "Nahi, mujhe koi nahi pata."
              },
              "patterns": [
                "no *",
                "no"
              ],
              "next": "end"
            }
          ]
        }
      ]
    },
