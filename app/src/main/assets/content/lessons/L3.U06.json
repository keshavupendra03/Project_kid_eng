      ],
      "text": {
        "hi": "‘मेरे पास है’ = I have. ‘उसके पास है’ = He has / She has.",
        "hinglish": "‘Mere paas hai’ = I have. ‘Uske paas hai’ = He has / She has.",
        "en": "Use ‘I have’ for things you own, and ‘He has’ or ‘She has’ for someone else."
      }
    },
    {
      "type": "learn_card",
      "id": "L3.U06.S02",
      "skills": [
        "grammar.have_has"
      ],
      "text": {
        "hi": "हिंदी में ‘है’ आख़िर में आता है। इंग्लिश में: I have a cat — ‘have’ बीच में!",
        "hinglish": "Hindi mein ‘hai’ aakhir mein aata hai. English mein: I have a cat — ‘have’ beech mein!",
        "en": "In Hindi, ‘hai’ comes last. In English: I have a cat — ‘have’ goes in the middle!"
      }
    },
