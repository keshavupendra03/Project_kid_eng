      "text": {
        "hi": "आज के 10 नए शब्द: अच्छा व्यवहार। हर शब्द सुनो, समझो और बोलो।",
        "hinglish": "Aaj ke 10 naye shabd: Achha vyavhaar. Har shabd suno, samjho aur bolo.",
        "en": "Ten new words today: Good manners. Listen, understand and say each one."
      }
    },
    {
      "type": "learn_word",
      "id": "W34.P10.S02",
      "skills": [
        "vocab.power"
      ],
      "word": {
        "english": "polite",
        "emoji": "🙂",
        "hindi": "विनम्र",
        "hinglish": "vinamra"
      },
      "meaning": "speaking and acting nicely to others",
      "example": "Always be polite to elders.",
      "exampleMeaning": {
        "hi": "बड़ों से हमेशा विनम्रता से बात करो।",
        "hinglish": "Badon se hamesha vinamrata se baat karo."
      }
    },
    {
      "type": "learn_word",
      "id": "W34.P10.S03",
      "skills": [
        "vocab.power"
      ],
      "word": {
        "english": "share",
        "emoji": "🤲",
        "hindi": "बाँटना",
        "hinglish": "baantna"
      },
      "meaning": "to give part of what you have to others",
      "example": "Share your toys with your friends.",
      "exampleMeaning": {
        "hi": "अपने खिलौने दोस्तों के साथ बाँटो।",
        "hinglish": "Apne khilaune doston ke saath baanto."
      }
    },
    {
      "type": "learn_word",
      "id": "W34.P10.S04",
      "skills": [
        "vocab.power"
      ],
      "word": {
        "english": "respect",
        "emoji": "🙇",
        "hindi": "आदर",
        "hinglish": "aadar"
      },
      "meaning": "to treat someone as important",
      "example": "We respect our teachers.",
      "exampleMeaning": {
        "hi": "हम अपने टीचरों का आदर करते हैं।",
        "hinglish": "Hum apne teacheron ka aadar karte hain."
      }
    },
    {
      "type": "learn_word",
      "id": "W34.P10.S05",
      "skills": [
        "vocab.power"
      ],
      "word": {
        "english": "apologise",
        "emoji": "😔",
        "hindi": "माफ़ी माँगना",
        "hinglish": "maafi maangna"
      },
      "meaning": "to say sorry",
      "example": "Apologise when you make a mistake.",
      "exampleMeaning": {
        "hi": "गलती हो जाए तो माफ़ी माँगो।",
        "hinglish": "Galti ho jaaye to maafi maango."
      }
    },
    {
      "type": "learn_word",
      "id": "W34.P10.S06",
      "skills": [
        "vocab.power"
      ],
      "word": {
        "english": "patient",
        "emoji": "⏳",
        "hindi": "धैर्यवान",
        "hinglish": "dhairyavaan"
      },
      "meaning": "able to wait without getting angry",
      "example": "Be patient when you wait for your turn.",
      "exampleMeaning": {
        "hi": "अपनी बारी का इंतज़ार करते समय धैर्य रखो।",
        "hinglish": "Apni baari ka intezaar karte samay dhairya rakho."
      }
    },
    {
      "type": "learn_word",
