    {
      "type": "learn_card",
      "id": "L3.U01.S01",
      "skills": [
        "grammar.this_that"
      ],
      "text": {
        "hi": "पास की चीज़ के लिए ‘This is’, दूर की चीज़ के लिए ‘That is’। यह = this, वह = that.",
        "hinglish": "Paas ki cheez ke liye ‘This is’, door ki cheez ke liye ‘That is’. Yeh = this, woh = that.",
        "en": "Use ‘This is’ for something near you, and ‘That is’ for something far away."
      }
    },
    {
      "type": "learn_card",
      "id": "L3.U01.S02",
      "skills": [
        "grammar.this_that"
      ],
      "text": {
        "hi": "रंगों को देखो! हिंदी में ‘है’ आख़िर में आता है: यह पेन है। इंग्लिश में ‘is’ बीच में: This is a pen.",
        "hinglish": "Rangon ko dekho! Hindi mein ‘hai’ aakhir mein aata hai: Yeh pen hai. English mein ‘is’ beech mein: This is a pen.",
        "en": "Look at the colours! In Hindi, ‘hai’ comes at the end. In English, ‘is’ comes in the middle: This is a pen."
      }
    },
