      ],
      "text": {
        "hi": "एक से ज़्यादा लोग हों, या ‘तुम’ से बात कर रहे हो, तो ‘are’: We are, You are, They are.",
        "hinglish": "Ek se zyaada log hon, ya ‘tum’ se baat kar rahe ho, to ‘are’: We are, You are, They are.",
        "en": "For more than one person, or when talking to ‘you’, use ‘are’: We are, You are, They are."
      }
    },
    {
      "type": "learn_card",
      "id": "L3.U04.S02",
      "skills": [
        "grammar.we_you_they"
      ],
      "text": {
        "hi": "हम = We, तुम = You, वे = They. याद रखो: I am, He/She/It is, बाकी सब are!",
        "hinglish": "Hum = We, tum = You, woh log = They. Yaad rakho: I am, He/She/It is, baaki sab are!",
        "en": "Remember: I am, He/She/It is, and all the rest use are!"
      }
    },
