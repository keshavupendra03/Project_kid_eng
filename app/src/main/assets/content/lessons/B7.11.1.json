      "scene": "🎉",
      "turns": [
        {
          "id": "name",
          "tinku": "Which festival do you like the most?",
          "meaning": {
            "hi": "तुम्हें कौन सा त्योहार सबसे ज़्यादा पसंद है?",
            "hinglish": "Tumhe kaun sa tyohaar sabse zyaada pasand hai?"
          },
          "replies": [
            {
              "say": "I like Diwali the most.",
              "meaning": {
                "hi": "मुझे दिवाली सबसे ज़्यादा पसंद है।",
                "hinglish": "Mujhe Diwali sabse zyaada pasand hai."
              },
              "patterns": [
                "i like *",
                "*",
                "* *"
              ]
            }
          ]
        },
