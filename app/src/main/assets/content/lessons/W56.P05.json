      },
      "meaning": "costing a lot of money",
      "example": "This toy is too expensive.",
      "exampleMeaning": {
        "hi": "यह खिलौना बहुत महँगा है।",
        "hinglish": "Yeh khilauna bahut mehnga hai."
      }
    },
