    {
      "type": "learn_card",
      "id": "B6.05.4.S03",
      "skills": [
        "book.talk",
        "speak.sentence"
      ],
      "text": {
        "hi": "arrive = आना, पहुँचना। depart = जाना, छूटना। a.m. = सुबह (आधी रात से दोपहर 12 तक), p.m. = दोपहर 12 के बाद से रात तक।",
        "hinglish": "arrive = aana, pahunchna. depart = jaana, chhootna. a.m. = subah (aadhi raat se dopahar 12 tak), p.m. = dopahar 12 ke baad se raat tak.",
        "en": "arrive = come in; depart = leave. a.m. is from midnight to noon; p.m. is from noon to midnight."
      }
    },
    {
      "type": "choice",
      "id": "B6.05.4.S04",
      "skills": [
        "book.talk",
        "speak.sentence"
      ],
      "question": "The train arrives at 9:30 p.m. and departs at 9:45 p.m. How long does it stop?",
      "questionMeaning": {
        "hi": "ट्रेन 9:30 पर आती है और 9:45 पर जाती है। कितनी देर रुकती है?",
        "hinglish": "Train 9:30 par aati hai aur 9:45 par jaati hai. Kitni der rukti hai?"
      },
      "options": [
        "15 minutes",
        "30 minutes",
        "45 minutes"
      ],
      "answer": "15 minutes"
    },
