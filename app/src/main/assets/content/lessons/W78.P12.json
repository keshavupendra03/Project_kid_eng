      "word": {
        "english": "sustainable",
        "emoji": "♻️",
        "hindi": "टिकाऊ",
        "hinglish": "tikaau"
      },
      "meaning": "able to continue without harming nature",
      "example": "We need sustainable ways to farm.",
      "exampleMeaning": {
        "hi": "हमें खेती के ऐसे तरीके चाहिए जो प्रकृति को नुकसान न पहुँचाएँ।",
        "hinglish": "Hamein kheti ke aise tareeke chahiye jo prakriti ko nuksaan na pahunchaayein."
      }
    },
